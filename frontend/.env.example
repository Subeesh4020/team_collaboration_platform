# Copy to .env.local and adjust. Only VITE_* variables reach the browser.
# Read them ONLY through src/config/env.ts.

# Display name of the product.
VITE_APP_NAME=Teamspace

# Base URL of the REST API. Relative paths are served by MSW in development.
VITE_API_BASE_URL=/api

# WebSocket endpoint for real-time events.
VITE_REALTIME_URL=ws://localhost:5173/realtime

# Use Mock Service Worker instead of a real backend. Defaults to true in dev, false in production.
VITE_ENABLE_MOCKS=true
